APP_NAME=MEDIC
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Секрет для подписи JWT: сгенерируйте командой `openssl rand -hex 32`
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

POSTGRES_USER=medic
POSTGRES_PASSWORD=medic
POSTGRES_DB=medic
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

RABBITMQ_USER=medic
RABBITMQ_PASSWORD=medic
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

FLOWER_USER=admin
FLOWER_PASSWORD=admin

MEDIA_DIR=media
