APP_NAME=MEDIC
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Логировать SQL-запросы (обычно выключено)
SQL_ECHO=false

# Источники фронтенда для CORS через запятую.
# При значении "*" credentials (cookie) автоматически отключаются.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Секрет для подписи JWT. В production ОБЯЗАТЕЛЬНО замените:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Минимум 32 байта. При APP_ENV=production приложение не стартует
# с ключом-заглушкой или коротким ключом.
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

POSTGRES_USER=medic
POSTGRES_PASSWORD=medic
POSTGRES_DB=medic
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Хранилище счётчиков неудачных входов (rate limiting).
# redis  — общее для всех инстансов (нужно при горизонтальном масштабировании)
# memory — в памяти процесса (локальная разработка без Redis)
# Если Redis недоступен, приложение автоматически перейдёт на memory
# и запишет предупреждение в лог.
LOGIN_GUARD_BACKEND=redis
LOGIN_GUARD_KEY_PREFIX=medic:login_guard

RABBITMQ_USER=medic
RABBITMQ_PASSWORD=medic
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

FLOWER_USER=admin
FLOWER_PASSWORD=admin

MEDIA_DIR=media
PRIVATE_MEDIA_DIR=private_media

# --- Bootstrap первого супер-админа ---
# Создаётся автоматически при старте, если в базе ещё нет администраторов.
# В production отключите BOOTSTRAP_ADMIN_ON_STARTUP и создайте админа через CLI.
# ВАЖНО: при APP_ENV=production приложение не стартует, если пароль остался
# дефолтным (Admin12345) при включённом BOOTSTRAP_ADMIN_ON_STARTUP.
BOOTSTRAP_ADMIN_ON_STARTUP=true
BOOTSTRAP_ADMIN_EMAIL=admin@medic.local
BOOTSTRAP_ADMIN_PASSWORD=Admin12345
BOOTSTRAP_ADMIN_PHONE=+70000000000
BOOTSTRAP_ADMIN_FIRST_NAME=Super
BOOTSTRAP_ADMIN_LAST_NAME=Admin
